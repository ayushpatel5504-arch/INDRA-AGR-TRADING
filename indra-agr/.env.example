# Application Settings
APP_NAME="INDRA AGR TRADING PVT. LTD."
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/indra-agr
APP_TIMEZONE=Asia/Kolkata

# Database (MySQL / MariaDB - InnoDB utf8mb4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=indra_agr_portal
DB_USERNAME=root
DB_PASSWORD=

# Session & Security
SESSION_LIFETIME=1800
SESSION_COOKIE_SECURE=false
CSRF_TOKEN_TTL=3600

# SMTP Email Configuration (PHPMailer)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="INDRA AGR TRADING PVT. LTD."

# SMS OTP Provider Configuration
SMS_PROVIDER=custom_http
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=INDAGR
SMS_TEMPLATE_ID=

# File Upload Limits (bytes)
MAX_PHOTO_SIZE=2097152
MAX_DOCUMENT_SIZE=5242880

# Payment Gateway Configuration (Server-Side Only — Never Expose Secrets to JS)
PAYMENT_GATEWAY=razorpay
PAYMENT_MODE=test
PAYMENT_CURRENCY=INR
PAYMENT_RECEIPT_PREFIX=INDRA-REC

# Razorpay Test & Live Credentials
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# Cashfree Payments Test & Live Credentials
CASHFREE_TEST_APP_ID=
CASHFREE_TEST_SECRET_KEY=
CASHFREE_TEST_WEBHOOK_SECRET=
CASHFREE_LIVE_APP_ID=
CASHFREE_LIVE_SECRET_KEY=
CASHFREE_LIVE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2023-08-01
