{
  "name": "indra-agr/recruitment-portal",
  "description": "Corporate Website & Online Job Recruitment Management Portal for INDRA AGR TRADING PVT. LTD.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "dompdf/dompdf": "^2.0",
    "phpmailer/phpmailer": "^6.9",
    "razorpay/razorpay": "^2.9",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
